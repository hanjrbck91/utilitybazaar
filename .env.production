# Production deployment configuration for utilitybazaar.in.
#
# NEXT_PUBLIC_SITE_URL is the only value the deployment needs. It is a
# public origin, not a secret, so it lives here for a reproducible build.
# A Vercel dashboard environment variable of the same name, if set, wins.
#
# Read at build time by src/lib/config.ts to produce canonical URLs,
# hreflang alternates, Open Graph URLs, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://utilitybazaar.in

# Intentionally unset — no analytics script, no cookies.
# NEXT_PUBLIC_GA_ID=

# Intentionally unset — no ad markup.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
