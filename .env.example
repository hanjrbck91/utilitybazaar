# Absolute production origin, no trailing slash.
# Required before deploying: canonical URLs, hreflang alternates, Open Graph
# URLs and the sitemap are all built from it. While it is unset, robots.txt
# disallows the whole site so a misconfigured deploy cannot be indexed.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Analytics 4 measurement ID. Leave empty to ship no analytics script
# and set no analytics cookies.
NEXT_PUBLIC_GA_ID=

# AdSense publisher ID (ca-pub-...). Leave empty to render no ad markup.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
